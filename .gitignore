# Отслеживаются только явно разрешённые файлы и каталоги
/*
!/.gitignore
!/AGENTS.md
!/Chatbot Visual Editor.docx
!/Vision_чат-бот_конструктор.docx
!/VP-chatbot/
!/docs/

# Монорепозиторий, инфраструктура и CI
!/package.json
!/pnpm-workspace.yaml
!/pnpm-lock.yaml
!/tsconfig.base.json
!/eslint.config.mjs
!/.dependency-cruiser.cjs
!/.prettierrc
!/vitest.workspace.ts
!/docker-compose.yml
!/.env.example
!/README.md
!/apps/
!/packages/
!/.github/
!/scripts/
!/Dockerfile
!/.dockerignore
!/deploy/

# Бэкапы Visual Paradigm
*.bak_*

# Артефакты сборки, зависимости и локальное окружение
node_modules/
dist/
.env
.env.*
!.env.example
!.env.prod.example
coverage/
*.tsbuildinfo

# Конфиг xray с секретами лежит только на сервере
deploy/xray/config.json

# Блокировка Visual Paradigm
*.lck
