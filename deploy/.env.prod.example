# Копия этого файла — deploy/.env.prod (в git не попадает). Значения ниже — образцы.
NODE_ENV=production
PUBLIC_URL=https://chatbot.nsumonkey.top
TELEGRAM_POLLING=0

# Пароль PostgreSQL
POSTGRES_PASSWORD=change-me-postgres

# Секрет JWT, не короче 32 символов. Генерация: openssl rand -base64 32
JWT_SECRET=change-me-change-me-change-me-change-me-jwt

# Ключи SecretVault: base64, ровно 32 байта; общие у api и engine.
# Генерация каждого: openssl rand -base64 32
VAULT_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
VAULT_HASH_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Ключ тестового API клиники (заголовок X-Api-Key)
MOCK_CLINIC_API_KEY=change-me-clinic-key
